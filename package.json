{
  "name": "zepp-cloud-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for Amazfit / Zepp health and workout data, with OAuth 2.1, SQLite sync and a self-hosted dashboard.",
  "license": "AGPL-3.0-or-later",
  "author": "Ary Arfani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryarfani/zepp-cloud-mcp.git"
  },
  "homepage": "https://github.com/aryarfani/zepp-cloud-mcp#readme",
  "bugs": {
    "url": "https://github.com/aryarfani/zepp-cloud-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zepp",
    "amazfit",
    "huami",
    "fitness",
    "health",
    "sleep",
    "hrv",
    "oauth2",
    "cloudflare-workers",
    "chatgpt",
    "claude"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server-node.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run -c vitest.node.config.ts",
    "test:node": "vitest run -c vitest.node.config.ts",
    "sync": "tsx scripts/sync.ts",
    "exercises:rederive": "tsx scripts/rederive-exercises.ts",
    "labels:rederive": "tsx scripts/rederive-exercises.ts",
    "test:watch": "vitest",
    "test:live": "tsx scripts/live-probe.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "dotenv": "^17.4.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.2",
    "@types/node": "26.4.0",
    "jsdom": "^30.1.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
